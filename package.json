{
  "name": "tree-sitter-hubl",
  "version": "1.0.0",
  "description": "Tree-sitter grammar for HubL (HubSpot templating language)",
  "license": "Unlicense",
  "keywords": [
    "tree-sitter",
    "parser",
    "hubl",
    "hubspot"
  ],
  "dependencies": {
    "nan": "^2.18.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.24.0"
  },
  "scripts": {
    "build": "tree-sitter generate",
    "test": "tree-sitter test"
  },
  "tree-sitter": [
    {
      "scope": "source.hubl",
      "injection-regex": "^hubl$",
      "file-types": [
        "hubl"
      ]
    }
  ]
}
